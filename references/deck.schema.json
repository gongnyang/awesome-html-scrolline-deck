{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gongnyang/awesome-html-scrolline-deck/references/deck.schema.json",
  "title": "Scrolline Deck — data/deck.json",
  "type": "object",
  "required": ["title", "scenes"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$" },
    "presenter": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "avatar": { "type": "string" },
        "autoDurationSec": { "type": "number", "minimum": 30, "maximum": 3600 }
      }
    },
    "links": {
      "type": "object",
      "description": "Deck-level links. `site` is the URL the closing-qr scene prints when copy.lines is empty; `scrolline qr --scene` and `add --url` set it.",
      "properties": { "site": { "type": "string" } },
      "additionalProperties": { "type": "string" }
    },
    "theme": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["dark", "light"] },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "scenes": {
      "type": "array",
      "uniqueItems": true,
      "x-uniqueBy": "id",
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "order", "technique", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{2}-[a-z0-9-]+$",
          "description": "Must equal the src/scenes/<id>/ folder name."
        },
        "order": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string", "minLength": 1, "description": "What this scene does for the talk." },
        "claim": { "type": "string", "minLength": 1, "description": "One sentence the audience should understand at the speaker hold." },
        "relation": { "type": "string", "enum": ["question", "comparison", "change", "sequence", "spatial", "structure", "decision", "atmosphere"] },
        "presenterAction": { "type": "string", "minLength": 1, "description": "What the speaker does or asks while the visual is held." },
        "visualChange": { "type": "string", "minLength": 1, "description": "What new information scrolling reveals, or why a static pass is enough." },
        "evidenceStatus": { "type": "string", "enum": ["sourced", "synthetic", "design-target", "concept", "none"] },
        "reason": { "type": "string", "minLength": 1, "description": "Why this composition and motion support the claim." },
        "evidence": { "type": "string", "description": "Visual or factual support for the claim." },
        "source": { "type": "string", "description": "Source, or an explicit fictional/illustrative label." },
        "technique": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Scene technique. The CLI resolves this against templates/scenes at authoring time; the catalog has no fixed upper limit."
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": 0.05, "maximum": 0.9 },
          "description": "Presenter keyboard landing ratios inside a pinned scene, in increasing order. Each cue must show a stable, meaningful state."
        },
        "pinVh": {
          "type": "integer",
          "minimum": 100,
          "maximum": 400,
          "description": "Pin distance as a percentage of viewport height."
        },
        "pace": {
          "type": "object",
          "required": ["mode", "scrollVh", "cueStates"],
          "properties": {
            "mode": { "type": "string", "enum": ["pass", "hold", "scrub"] },
            "scrollVh": { "type": "integer", "minimum": 0, "maximum": 400 },
            "cueStates": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "type": "object", "required": ["at", "message"],
                "properties": {
                  "at": { "type": "number", "minimum": 0, "maximum": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "pin": { "type": "boolean" },
        "assets": {
          "type": "object",
          "properties": {
            "frames": {
              "type": ["string", "null"],
              "pattern": "%0\\dd",
              "description": "Frame sequence pattern, e.g. /frames/hero/f_%03d.jpg"
            },
            "mobileFrames": { "type": ["string", "null"], "pattern": "%0\\dd" },
            "count": { "type": "integer", "minimum": 0, "maximum": 240 },
            "critical": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
            "poster": { "type": ["string", "null"] },
            "images": { "type": "array", "items": { "type": "string" } },
            "imageAlt": { "type": "array", "maxItems": 10, "items": { "type": "string" }, "description": "horizontal-gallery: alt text aligned with images" },
            "series": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "number" }, "description": "annotated-chart: actual values with a declared unit, never silently normalized" },
            "xLabels": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "string" } },
            "unit": { "type": "string" },
            "annotationIndex": { "type": "integer", "minimum": 0, "maximum": 19 },
            "matrix": {
              "type": "object",
              "description": "option-matrix: explicit comparison values; only supplied recommendations are highlighted",
              "properties": {
                "options": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
                "criteria": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
                "values": { "type": "array", "maxItems": 4, "items": { "type": "array", "maxItems": 3, "items": { "type": ["string", "number", "null"] } } },
                "recommendedIndex": { "type": "integer", "minimum": 0, "maximum": 2 }
              }
            },
            "video": { "type": ["string", "null"] },
            "rows": {
              "type": "array",
              "description": "anatomy-rows: explicit rows instead of parsing copy.lines",
              "items": { "type": "object", "properties": { "label": { "type": "string" }, "value": { "type": "string" } }, "required": ["label", "value"] }
            },
            "marks": {
              "type": "array",
              "description": "anatomy-rows: [x, y] in % of the image for each row's mark; falls back to the template's spread",
              "items": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 }, "minItems": 2, "maxItems": 2 }
            },
            "caption": { "type": "string", "description": "horizontal-gallery: caption under the rail" },
            "restartLabel": { "type": "string", "description": "closing-qr: label of the link back to scene one" }
          }
        },
        "copy": {
          "type": "object",
          "properties": {
            "kicker": { "type": "string" },
            "title": { "type": "string" },
            "lines": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
          }
        },
        "transition": {
          "type": "object",
          "properties": {
            "in": { "type": "string" },
            "out": { "type": "string" }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Speaker notes. Shown in the N panel; required for every scene."
        },
        "audio": {
          "type": "object",
          "required": ["src"],
          "properties": {
            "src": { "type": "string" },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "fallback": { "type": "string" }
      }
    }
  }
}
